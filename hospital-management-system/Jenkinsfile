pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven'
        nodejs 'NodeJS18'
    }

    environment {
        JAVA_HOME = tool('JDK17')
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Backend') {
            steps {
                dir('hospital-management-system') {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        //stage('Run Backend Tests') {
            //steps {
                //dir('hospital-management-system') {
                    //sh 'mvn test'
                //}
            //}
        //}
        stage('Check Frontend Files') {
		    steps {
		        sh 'ls -l hospital-management-system/Front/front/employee-front'
		        sh 'test -f hospital-management-system/Front/front/employee-front/package.json'
		    }
		}


        stage('Install Frontend Dependencies') {
            steps {
                dir('hospital-management-system/Front/front/employee-front') {
                    sh 'npm install'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('hospital-management-system/Front/front/employee-front') {
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose -f hospital-management-system/docker-compose.yml build'
            }
        }

        stage('Run Docker Containers') {
            steps {
                sh 'docker compose -f docker-compose.yml up -d'
            }
        }

        stage('Check Running Containers') {
            steps {
                sh 'docker ps'
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning up Docker containers..."
            sh 'docker compose -f docker-compose.yml down'
        }
        success {
            echo '✅ Build and deployment succeeded!'
        }
        failure {
            echo '❌ Build failed!'
        }
    }
}
