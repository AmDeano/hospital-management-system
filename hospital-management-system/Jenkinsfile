pipeline {
    agent any

    tools {
        jdk 'JDK17'       // Jenkins tool name for JDK 17
        maven 'Maven'     // Jenkins tool name for Maven
        nodejs 'NodeJS18' // Jenkins tool name for Node.js 18
    }

    environment {
        JAVA_HOME = tool('JDK17')
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Backend') {
            steps {
                dir('hospital-management-system') {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Run Backend Tests') {
            steps {
                dir('hospital-management-system') {
                    sh 'mvn test'
                }
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir('Front/front/employee-front') {
                    sh 'npm install'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('Front/front/employee-front') {
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo '✅ Build succeeded!'
        }
        failure {
            echo '❌ Build failed!'
        }
    }
}
