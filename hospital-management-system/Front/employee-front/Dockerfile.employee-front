# ===============================
# Stage 1 - Build (Production)
# ===============================
FROM node:20-alpine AS build

# Set working directory
WORKDIR /app

# Install Angular CLI globally
RUN npm install -g @angular/cli@20.1.6

# Copy package files first (for better caching)
COPY Front/employee-front/package*.json ./

# Install dependencies
RUN npm ci --silent

# Copy source code
COPY Front/employee-front/ .

# Build Angular app for production
RUN npm run build -- --configuration production

# ===============================
# Stage 2 - Runtime (Production with Nginx)
# ===============================
FROM nginx:1.25-alpine AS prod

# Copy built Angular dist to Nginx html folder
COPY --from=build /app/dist/employee-front /usr/share/nginx/html

# Copy custom Nginx config (optional if you want SPA fallback)
# COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ===============================
# Stage 3 - Development (optional)
# ===============================
FROM node:20-alpine AS dev

WORKDIR /app

# Install Angular CLI globally
RUN npm install -g @angular/cli@20.1.6

# Copy package files first
COPY Front/employee-front/package*.json ./

# Install all dependencies (with devDependencies)
RUN npm install

# Copy source code
COPY Front/employee-front/ .

# Create a non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S angular -u 1001 -G nodejs && \
    chown -R angular:nodejs /app
USER angular

# Expose Angular dev server port
EXPOSE 4200

# Create a startup script to inject environment variables
RUN echo '#!/bin/sh' > /app/entrypoint.sh && \
    echo 'echo "Starting Angular dev server..."' >> /app/entrypoint.sh && \
    echo 'ng serve --host 0.0.0.0 --port 4200 --poll 2000' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

# Default command for development
CMD ["/app/entrypoint.sh"]
